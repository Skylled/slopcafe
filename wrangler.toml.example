# Cloudflare Worker config — TEMPLATE.
#
# COPY THIS FILE to `wrangler.toml`, fill in the <PLACEHOLDERS>, then deploy.
# The real `wrangler.toml` is gitignored on purpose so your account/resource IDs
# never land in version control. Everything you must change is marked <LIKE_THIS>.
# See: https://developers.cloudflare.com/workers/wrangler/configuration/

name = "slopcafe"
main = "src/index.ts"
compatibility_date = "2026-05-26"
compatibility_flags = ["nodejs_compat"]

# Your Cloudflare account ID. Find it with `npx wrangler whoami` or in the
# dashboard (Workers & Pages → Overview → Account ID).
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

# Publish to <name>.<your-subdomain>.workers.dev — the zero-DNS way to get a live
# URL. Once a custom domain is wired up below you can flip this to false.
workers_dev = true

# ---- Custom domain routes (OPTIONAL) ------------------------------------------
# Bind your own domain to this Worker. Requires the zone to already exist in this
# Cloudflare account (nameservers pointed at Cloudflare). `custom_domain = true`
# makes Cloudflare provision the TLS cert and route DNS automatically — no manual
# A/AAAA records. Leave this commented out to launch on workers.dev first.
#
# routes = [
#   { pattern = "example.com", custom_domain = true },
#   { pattern = "www.example.com", custom_domain = true },
# ]

# ---- Observability: Workers Logs (OPTIONAL) -----------------------------------
# Per-request invocation logs (method, URL, status, outcome, duration) in the
# dashboard — Workers & Pages → <worker> → Logs — with no code change. Verified
# against the live docs (2026-09-03):
# https://developers.cloudflare.com/workers/observability/logs/workers-logs/
#
# head_sampling_rate is the fraction of requests logged, 0 to 1 (0 = none,
# 1 = every request); unset defaults to 1. Lower it on a busy zone to control
# log volume; at Slopcafe's single-operator traffic level 1 is fine.
#
# Workers Logs record the request line (URL, method, status) automatically —
# they do NOT include custom request headers. Reading one (e.g. the MCP
# 2026-07-28 `Mcp-Name` header) into a log needs an explicit console.log() in
# code, which this template doesn't add. So turning this on alone gives you
# overall /mcp traffic volume, not a per-tool breakdown — that's an edge-rule
# job; see docs/operating.md's "Edge rules for the MCP surface (SEP-2243
# headers)" section.
#
# [observability]
# enabled = true
# head_sampling_rate = 1

# ---- R2: sanitized HTML bytes -------------------------------------------------
# Create once:  npx wrangler r2 bucket create slopcafe-docs
# In code: env.DOCS.put(key, body) / .get(key) / .delete(key)
[[r2_buckets]]
binding = "DOCS"
bucket_name = "slopcafe-docs"

# ---- D1: metadata (documents, versions, agents, agent_keys, oauth_clients) ----
# Create once:  npx wrangler d1 create slopcafe-meta
# then paste the printed database_id below. Apply schema with `npm run db:migrate:*`.
[[d1_databases]]
binding = "META"
database_name = "slopcafe-meta"
database_id = "<YOUR_D1_DATABASE_ID>"
migrations_dir = "migrations"

# ---- Workers AI: query/document embeddings for hybrid search ------------------
# env.AI.run("@cf/qwen/qwen3-embedding-0.6b", …) → 1024-dim vectors (src/vector-io.ts).
# Included on the Workers Free plan (daily neuron allowance); our corpus is a
# rounding error against it (vector-search-design.md §15). No setup beyond binding.
[ai]
binding = "AI"

# ---- Vectorize: semantic index (1024-dim cosine) ------------------------------
# Create once (dims/metric are immutable, so get them right the first time):
#   npx wrangler vectorize create slopcafe-docs --dimensions=1024 --metric=cosine
# Holds N chunk vectors per document, keyed `${documents.id}#${i}`. A candidate
# ranker only — the authoritative live/visible check stays in D1.
[[vectorize]]
binding = "VECTORIZE"
index_name = "slopcafe-docs"

# ---- KV: OAuth provider state (clients, grants, tokens) -----------------------
# Create once:  npx wrangler kv namespace create OAUTH_KV
# then paste the printed id below. Owned by @cloudflare/workers-oauth-provider.
[[kv_namespaces]]
binding = "OAUTH_KV"
id = "<YOUR_OAUTH_KV_NAMESPACE_ID>"

# ---- Secrets ------------------------------------------------------------------
# Don't put real secrets here. Set them with:
#   npx wrangler secret put HMAC_PEPPER
#   npx wrangler secret put OPERATOR_TOKEN
#   npx wrangler secret put READER_TOKENS     # OPTIONAL — see below
# For local dev (`npm run dev`), copy .dev.vars.example → .dev.vars and put the
# same values there. [vars] below is for NON-secret config only.
#
# READER_TOKENS (optional) — the READ-ONLY human tier. A comma-separated list of
# per-person tokens:
#
#   npx wrangler secret put READER_TOKENS
#   # paste, on one line:  alice-<random>,bob-<random>,carol-<random>
#
# ONE TOKEN PER PERSON. That is the entire revocation story: a leaked token is
# revoked by re-putting the secret WITHOUT that entry, which invalidates only
# that person's live browser sessions — everyone else, and the operator, stays
# signed in. (Bumping SESSION_EPOCH or rotating OPERATOR_TOKEN still logs out
# EVERYONE, readers included.)
#
# What a reader token buys: sign in at /login with it, then read everything —
# document shells, /raw, /text, /source, /links, version history, search, the
# document list, and the console's Dashboard + Documents pages — INCLUDING
# private documents. What it can never do: publish, update, edit, retag,
# re-status, change visibility, promote, rename a slug, restore, revoke, mint or
# revoke agents/keys/OAuth clients, or run a backfill. Every one of those refuses
# a reader with the byte-identical response an anonymous caller gets.
#
# Leave READER_TOKENS unset and the tier does not exist — mainline behavior.
# Generate one per person the same way as the other secrets:
#   openssl rand -base64 36 | tr -d '\n=' | tr '/+' '_-'

# Import `.wasm` files as `WebAssembly.Module` so the Rust sanitizer bundles
# directly (instead of being fetched at runtime via import.meta.url, which doesn't
# exist on Workers).
[[rules]]
type = "CompiledWasm"
globs = ["**/*.wasm"]
fallthrough = true

# Import `.html` and `.md` files as strings. Two consumers:
#   * the MCP Apps document-viewer template (src/mcp-app-template.html), served
#     as the ui://slopcafe/document-view.html resource over /mcp — it never
#     loads from this origin: an Apps host fetches it via resources/read and
#     renders it in ITS sandbox;
#   * the generated platform-documentation bundle (src/generated/docs/*.md and
#     *.html), built by scripts/build-docs.mjs and served at /docs/<name>, which
#     is what makes an instance's docs match its own deployed build (issue #4).
[[rules]]
type = "Text"
globs = ["**/*.html", "**/*.md"]
fallthrough = true

[vars]
# Fleet-wide storage cap (bytes), enforced in the write path. Single-operator, so
# this is the total budget across every agent's documents.
STORAGE_CAP_BYTES = "2147483648"  # 2 GiB

# Browser-session signing epoch — a rotation counter, NOT a secret. Bump it (e.g.
# "1" → "2") and redeploy to invalidate every operator browser session at once.
SESSION_EPOCH = "1"

# Birth visibility for newly published documents — "private" (default) or "public".
# With "private", a freshly published doc is NOT served on the anonymous/public web
# until the operator explicitly makes it public. Any value other than exactly
# "public" clamps to "private" in code (src/access.ts).
DEFAULT_DOCUMENT_VISIBILITY = "private"

# Origins allowed to call this API from a browser on a DIFFERENT origin — e.g. a
# Flutter Web build of the operator app hosted elsewhere. Comma-separated, exact
# origins (scheme + host + optional port), no paths, no wildcards.
#
#   CORS_ALLOWED_ORIGINS = "https://app.example.com, http://localhost:5173"
#
# EMPTY OR UNSET (the default — this line stays commented out) = CORS entirely
# off: the Worker adds no cross-origin headers at all and behaves exactly as it
# did before the feature existed. Leave it that way unless you actually run a
# separate web front end.
#
# Matching is EXACT after normalization, so "https://example.com" never admits
# "https://example.com.evil.test". An entry that isn't a well-formed http(s)
# origin is dropped with a log line and the rest still apply; "*" is NOT a
# wildcard — it fails to parse, so setting it leaves CORS off. Check what was
# actually loaded with:
#   curl -H 'Origin: https://app.example.com' https://<your-host>/healthz
# and read the `cors` block.
#
# Cross-origin callers are BEARER-ONLY. The Worker never emits
# Access-Control-Allow-Credentials, so operator session cookies can neither be
# sent nor read across origins — a browser client must hold an agent key or the
# operator token explicitly. The HTML/cookie surfaces (/login, /authorize,
# /admin/console/*, /d/:id/manage) are excluded from CORS regardless. See the
# header of src/cors.ts.
# CORS_ALLOWED_ORIGINS = ""

# The document rendered at `/` — your public landing page — by `public_id`.
#
# EMPTY OR UNSET (the default — this line stays commented out) = no homepage
# configured: `/` serves a short "<brand> is running" placeholder instead. That
# is the correct state for a fresh deployment, whose database has no documents
# in it yet.
#
# One-time bootstrap, once you have an agent key or the operator token:
#   1. Publish a document (MCP `publish_document`, `POST /d`, or the console).
#   2. Make it public and promote it   — POST /admin/documents/<id>/visibility
#                                        then .../promote, or use /d/<id>/manage.
#   3. Put its public_id here and redeploy.
#
# It must be a valid 22-character public_id and the document must be PUBLIC:
# `/` is an anonymous surface, so a private (or missing, revoked, or malformed)
# id degrades to the same placeholder rather than leaking anything. Slugs are
# not accepted here — this takes a public_id only.
# HOMEPAGE_PUBLIC_ID = ""

# App Links / Universal Links verification (issue #50) — OPTIONAL, and only
# useful if you have a companion mobile app that should open /d/… and /s/…
# links in-app instead of a browser tab.
#
# EMPTY OR UNSET (the default — leave all three lines commented out) means
# GET /.well-known/assetlinks.json and GET /.well-known/apple-app-site-association
# answer the ordinary opaque 404, byte-identical to a deployment without this
# feature. Android and iOS resolve independently; set only the platform(s) you
# ship. Android is all-or-nothing — both APP_LINKS_ANDROID_PACKAGE and
# APP_LINKS_ANDROID_SHA256 must be set and valid, or assetlinks.json stays
# unconfigured even if one of the two is present.
#
#   APP_LINKS_ANDROID_PACKAGE = "com.example.slopcafe"
#   APP_LINKS_ANDROID_SHA256 = "AA:BB:CC:...:FF"   # comma-separated if more than one signing key
#   APP_LINKS_APPLE_APP_ID = "ABCDE12345.com.example.slopcafe"   # <TEAMID>.<bundle id>
#
# Find your Android fingerprint: `keytool -list -v -keystore <path-to-keystore>`
# for a local signing key, or Play Console → your app → Setup → App integrity →
# App signing → "SHA-256 certificate fingerprint" for Play App Signing.
# Find your Apple Team ID: Apple Developer portal → Membership details.
#
# Verify what's live: `curl https://<your-host>/.well-known/assetlinks.json`
# and `curl https://<your-host>/.well-known/apple-app-site-association` — both
# must return 200 with no redirect for the OS-level verifier to accept them.

# Single-publisher WRITE allowlist — a comma-separated list of agent ids (the
# `id` column of the `agents` table, a UUID) permitted to WRITE. NOT a secret:
# these ids are already listed by `GET /admin/agents` and shown in the console.
#
#   WRITER_AGENT_IDS = "0f2a…-…,"        # one id, or several
#
# EMPTY OR UNSET = OFF, and off means the historical whole-fleet behavior: every
# active agent key may write. That default is deliberate — a deployment keeps
# working before this var is ever set, and a typo'd/emptied value fails OPEN
# rather than locking the publisher out of its own corpus. (The reader tier fails
# the other way: a broken READER_TOKENS means nobody can sign in as a reader.)
#
# When non-empty, an agent NOT on the list gets `403 read_only_agent` from every
# write — POST /d, PUT /d/:id, PUT /d/:id/tags, PUT /d/:id/status, and the MCP
# publish_document / update_document / edit_document / set_document_tags /
# set_document_status tools — through BOTH doors, because the check lives in the
# shared write cores (src/document-write.ts, src/document-lifecycle.ts),
# not in the routes. READS are untouched: a
# non-writer key still lists, reads, searches and packs. Ephemeral keys from
# `create_publish_credential` inherit their caller's agent identity, so they are
# refused identically. OPERATOR-authored writes (POST/PUT /admin/documents, the
# manage-page forms, restore) are never restricted by this var.
#
# To find the id of the agent that should publish here:
#   curl -s -H "Authorization: Bearer $OPERATOR_TOKEN" https://<host>/admin/agents
# …or open /admin/console/agents. Then set it and redeploy:
#   WRITER_AGENT_IDS = "<that id>"
WRITER_AGENT_IDS = ""
