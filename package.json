{
  "name": "slopcafe",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "description": "A Cloudflare Worker that lets authenticated agents publish HTML at unguessable URLs.",
  "main": "src/index.ts",
  "scripts": {
    "build:wasm": "cd sanitizer && PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build --target web --release --no-typescript",
    "build:openapi": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs scripts/build-openapi.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "predeploy": "npm run build:wasm && npm run build:openapi && npm run build:docs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sanitizer && npm run test:advisories && npm run test:metadata && npm run test:pagination && npm run test:search && npm run test:edit && npm run test:integrity && npm run test:auth && npm run test:session && npm run test:access && npm run test:cors && npm run test:conditional && npm run test:served-version && npm run test:depth && npm run test:vector && npm run test:pack && npm run test:search-ranking && npm run test:mcp-errors && npm run test:authorize && npm run test:contract && npm run test:openapi && npm run test:docs-bundle && npm run test:lockstep",
    "test:sanitizer": "cd sanitizer && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test",
    "test:advisories": "node --experimental-strip-types --no-warnings test/advisories.test.mjs",
    "test:metadata": "node --experimental-strip-types --no-warnings test/metadata.test.mjs",
    "test:pagination": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/pagination.test.mjs",
    "test:search": "node --experimental-strip-types --no-warnings test/search.test.mjs",
    "test:edit": "node --experimental-strip-types --no-warnings test/edit.test.mjs",
    "test:integrity": "node --experimental-strip-types --no-warnings test/integrity.test.mjs",
    "test:auth": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/auth.test.mjs",
    "test:session": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/session.test.mjs",
    "test:access": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/access.test.mjs",
    "test:cors": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/cors.test.mjs",
    "test:conditional": "node --experimental-strip-types --no-warnings test/conditional.test.mjs",
    "test:depth": "node --experimental-strip-types --no-warnings test/depth.test.mjs",
    "test:vector": "node --experimental-strip-types --no-warnings test/vector.test.mjs",
    "test:pack": "node --experimental-strip-types --no-warnings test/pack.test.mjs",
    "test:contract": "node --experimental-strip-types --no-warnings test/contract.test.mjs",
    "test:openapi": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/openapi.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply META --local",
    "db:migrate:remote": "wrangler d1 migrations apply META --remote",
    "db:console:local": "wrangler d1 execute META --local --command",
    "db:console:remote": "wrangler d1 execute META --remote --command",
    "test:authorize": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/authorize-callback.test.mjs",
    "test:search-ranking": "node --experimental-strip-types --no-warnings test/search-ranking.test.mjs",
    "test:mcp-errors": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/mcp-errors.test.mjs",
    "test:served-version": "node --experimental-strip-types --no-warnings --import=./test/register-ts-resolver.mjs test/served-version.test.mjs",
    "test:docs-bundle": "node --experimental-strip-types --no-warnings test/docs-bundle.test.mjs",
    "test:lockstep": "node scripts/lockstep-check.mjs --self-test",
    "test:e2e": "bash scripts/run-e2e.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5.5.0",
    "wrangler": "4.128.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skylled/slopcafe.git"
  },
  "keywords": [],
  "author": "Skylled / Kyle Bradshaw",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Skylled/slopcafe/issues"
  },
  "homepage": "https://github.com/Skylled/slopcafe#readme",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
